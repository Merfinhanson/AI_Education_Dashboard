APP_ENV=development
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///./storage/evaluation.db
STORAGE_DIR=./storage/uploads
ENABLE_DEMO_FALLBACK=true
PLAGIARISM_TEXT_THRESHOLD=0.92
PLAGIARISM_STRUCTURAL_THRESHOLD=0.85
EVALUATION_SIMILARITY_THRESHOLD=0.62
OCR_ENABLE_HANDWRITING_MODEL=true
OCR_HANDWRITING_MODEL_DIR=./training/handwriting/models/trocr-finetuned
OCR_DEVICE=cpu
OCR_MAX_NEW_TOKENS=256
